# Your Discord Bot Token (Get from https://discord.com/developers/applications)
DISCORD_TOKEN=YOUR_DISCORD_TOKEN

# Your Discord User ID (Enable Developer Mode in Discord settings, right-click your profile -> Copy User ID)
OWNER_ID=YOUR_DISCORD_ID

# The ID of the role that has administrator privileges
ADMIN_ROLE_ID=THE_ROLE_ID_FOR_ADMINISTRATOR

# The ID of the specific channel where the bot is allowed to chat and listen
TARGET_CHANNEL_ID=THE_DESIGNATED_CHANNEL_ID

# Your Discord Server (Guild) ID
GUILD_ID=YOUR_SERVER_ID